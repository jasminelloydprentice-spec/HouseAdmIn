# ── Client (bundled into the app — public by design; RLS is the boundary) ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional dev flags
# Show the developer section (cost estimator) in Settings
EXPO_PUBLIC_DEV_TOOLS=false
# Hint shown in dev UI that the backend mock provider is expected
EXPO_PUBLIC_DEV_MOCK_AI=false

# ── Edge Function secrets (NEVER in the client; set with `supabase secrets set`
#    or put in supabase/functions/.env for `supabase functions serve`) ──
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-sonnet-5
# ANALYSIS_MAX_PAGES=20
# ANALYSIS_INPUT_COST_PER_MTOK=3.00
# ANALYSIS_OUTPUT_COST_PER_MTOK=15.00
# MOCK_ANALYSIS=false
# RATE_LIMIT_PROCESS_PER_HOUR=30
# RATE_LIMIT_ASK_PER_HOUR=60
# SIGNED_URL_TTL_SECONDS=300
